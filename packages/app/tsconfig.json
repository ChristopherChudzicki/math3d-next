{
  "extends": "@math3d/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "vite.config.ts",
    "vitest.worker.config.ts",
    "vite-plugins"
  ],
  // The Worker is typechecked separately with Workers (not DOM) types; see
  // src/worker/tsconfig.json.
  "exclude": ["src/worker"]
}

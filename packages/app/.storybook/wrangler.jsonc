// Assets-only Worker hosting per-PR Storybook previews (.github/workflows/storybook-preview.yml).
// Never `wrangler deploy`ed: it exists only to hold Previews.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "math3d-storybook",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../storybook-static"
  },
  // Required by `wrangler preview`; the previews need no settings of their own.
  "previews": {}
}

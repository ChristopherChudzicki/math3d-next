  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@faker-js/faker": "^10.6.0",
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@math3d/eslint-config": "workspace:^",
    "@math3d/mock-api": "workspace:^",
    "@math3d/test-utils": "workspace:^",
    "@math3d/tsconfig": "workspace:^",
    "@mswjs/data": "^0.16.2",
    "@sentry/vite-plugin": "^5.4.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",

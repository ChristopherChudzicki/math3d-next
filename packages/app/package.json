{
  "name": "app",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "concurrently 'yarn css-types --watch' 'node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env ../../node_modules/.bin/vite'",
    "css-types": "tcm src",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-storybook": "node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env ../../node_modules/.bin/storybook build",
    "lint": "eslint --max-warnings 0 \"**/*.ts?(x)\"",
    "storybook": "concurrently 'yarn css-types --watch' 'node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env ../../node_modules/.bin/storybook dev -p 6006'",
    "test": "node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env ../../node_modules/.bin/vitest --run",
    "test-watch": "node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env ../../node_modules/.bin/vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.0.1",
    "@iconify-icons/lucide": "^1.2.136",
    "@iconify/react": "^6.0.2",
    "@math3d/api": "workspace:^",
    "@math3d/custom-mathjs": "workspace:^",
    "@math3d/mathitem-configs": "workspace:^",
    "@math3d/mathjs-utils": "workspace:*",
    "@math3d/mathscope": "workspace:^",
    "@math3d/parser": "workspace:^",
    "@math3d/react-textarea-autosize": "8.3.5",
    "@math3d/utils": "workspace:^",
    "@reduxjs/toolkit": "^2.2.3",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.62.10",
    "@testing-library/dom": "^10.4.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "classnames": "2.5.1",
    "fast-json-patch": "^3.1.1",
    "history": "5.3.0",
    "lodash-es": "4.18.1",
    "mathbox": "^2.3.1",
    "mathbox-react": "^1.0.1",
    "mathlive": "^0.110.0",
    "ordinal": "1.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.56.1",
    "react-infinite-scroll-component": "^6.1.1",
    "react-redux": "^9.1.0",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1",
    "showdown": "^2.1.0",
    "tarjan-graph": "3.0.0",
    "three": "^0.147.0",
    "tiny-invariant": "^1.3.3",
    "tinycolor2": "1.6.0",
    "toposort": "2.0.2",
    "use-long-press": "^3.3.0",
    "yup": "^1.3.2"

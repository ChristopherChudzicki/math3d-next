{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "math3d-screenshots",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-04",
  // Required: @cloudflare/puppeteer statically imports node:buffer (and other
  // node builtins) from its Cloudflare entrypoint. Without this flag the bundle
  // uploads with only a warning but the Worker fails to START ("No such module
  // node:buffer") — 500ing EVERY request, including /health and the R2 cache-hit
  // path. vitest-pool-workers can't catch it (it resolves node:buffer via Vite,
  // not the wrangler bundle), so this must not be removed.
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev subdomain for the free-tier experiment (zero DNS). The deployed
  // URL becomes the app Worker's SCREENSHOTS_ORIGIN (Task 7). A branded custom
  // domain is later polish.
  "workers_dev": true,
  // Retain invocation logs in Workers Logs. Render failures are logged via
  // console.error on a fire-and-forget ctx.waitUntil path — set
  // this explicitly (rather than rely on an account default) so those traces
  // survive for after-the-fact debugging instead of being live-`wrangler tail`
  // only, which nobody is running at the moment a render quietly fails.
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "SCREENSHOTS_BUCKET", "bucket_name": "math3d-screenshots" }
  ],
  // FRAME_ORIGIN is NOT set here: it's the site origin, injected at deploy time
  // via `wrangler deploy --var` (deploy-reusable.yml) from the same
  // VITE_SITE_ORIGIN GitHub Actions variable the app build and app Worker use,
  // so all three copies of the origin stay in lockstep. For local `wrangler
  // dev`, copy `.dev.vars.example` to `.dev.vars` (gitignored). RENDER_DEADLINE_MS
  // is a fixed tuning constant with no cross-system twin, so it stays in-file.
  "vars": {
    "RENDER_DEADLINE_MS": 60000
  }
  // RENDER_SECRET (gates POST /render) is intentionally NOT set here as a
  // plaintext var — it's a Worker secret, set via `wrangler secret put
  // RENDER_SECRET` (or the Cloudflare dashboard), not committed to this file.
  // Per ADR-0002, point it at the value of an existing shared secret so it
  // matches the backend's RENDER_SECRET env — the two must be equal for the
  // bearer check in src/index.ts to pass. Tests supply their own value via
  // vitest.config.ts bindings.
}

    {
      "id": "3",
      "type": "EXPLICIT_SURFACE",
      "properties": {
        "description": "Explicit Surface:\nWe can use the slider variables defined above in defining a surface (or any expression)",
        "color": "#3090FF",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "0.75",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y"],
          "rhs": "\\frac{A}{b}\\cdot x\\cdot e^{-\\frac{x^2+y^2}{b^2}}"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["y"],
              "rhs": "\\left[-4,4\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["x"],
              "rhs": "\\left[-4,4\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["X", " Y", " Z", " x", " y"],
          "rhs": "mod(Z, 1)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "64",
        "samples2": "64",
        "grid1": "8",
        "grid2": "8"
      }
    },
    {
      "id": "1",
      "type": "VARIABLE_SLIDER",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "A",
          "rhs": "10"
        },
        "fps": "60",
        "range": {
          "type": "array",
          "items": ["-20", "20"]
        },
        "duration": "4",
        "description": "Variable Slider",
        "isAnimating": "false",
        "speedMultiplier": "1"
      }
    },
    {
      "id": "2",
      "type": "VARIABLE_SLIDER",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "b",
          "rhs": "2.1"
        },
        "fps": "60",
        "range": {
          "type": "array",
          "items": ["0.5", "3"]
        },
        "duration": "4",
        "description": "Another Slider!",
        "isAnimating": "false",
        "speedMultiplier": "1"
      }
    }

    {
      "id": "3",
      "type": "PARAMETRIC_SURFACE",
      "properties": {
        "description": "Parametric Surface:\nThis sphere uses g(u - T, v) as its color map.\nHold-press the rainbow, then switch to \"Color Map\" for details.",
        "color": "temperature",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "0.75",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "false",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["u", "v"],
          "rhs": "3f\\left(u,v\\right)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["v"],
              "rhs": "\\left[0,2\\pi\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["u"],
              "rhs": "\\left[0,\\pi\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["X", " Y", " Z", " u", " v"],
          "rhs": "g\\left(u-T,v\\right)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "128",
        "samples2": "128",
        "grid1": "8",
        "grid2": "8"
      }
    },
    {
      "id": "4",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "f\\left(\\phi,\\ \\theta\\right)",
          "rhs": "\\left[\\cos\\left(\\phi\\right)\\cdot\\sin\\left(\\theta\\right),\\ \\sin\\left(\\phi\\right)\\cdot\\sin\\left(\\theta\\right),\\cos\\left(\\theta\\right)\\right]"
        },
        "description": "Parametric description of sphere:"
      }
    },
    {

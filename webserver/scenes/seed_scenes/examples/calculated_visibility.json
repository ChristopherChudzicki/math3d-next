    {
      "id": "6",
      "type": "EXPLICIT_SURFACE_POLAR",
      "properties": {
        "description": "Explicit Surface (Polar)\nTo control an object's visibility with a toggle, open its settings (press the gear) and set Calculated Visibility to the toggle's name.",
        "color": "#3090FF",
        "visible": true,
        "calculatedVisibility": "show",
        "useCalculatedVisibility": true,
        "opacity": "0.75",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["r", "\\theta"],
          "rhs": "\\frac{1}{4}r^2\\cdot\\cos\\left(3\\theta\\right)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["\\theta"],
              "rhs": "\\left[0,\\ 3\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["r"],
              "rhs": "\\left[-\\pi,\\ \\pi\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y", "z", "r", "\\theta"],
          "rhs": "mod(\\operatorname{rescale}_z\\left(z\\right), 1)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "64",
        "samples2": "64",
        "grid1": "8",
        "grid2": "8"
      }
    },
    {
      "id": "1",
      "type": "BOOLEAN_VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "show",
          "rhs": "true"
        },
        "description": "Toggle Switch\nA toggle switch is a boolean variable (true or false). One toggle can control the visibility of several objects at once."
      }
    }

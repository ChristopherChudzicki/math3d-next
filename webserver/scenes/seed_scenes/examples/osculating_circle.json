    {
      "id": "3",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "r(t)",
          "rhs": "\\left[\\ 2\\cos\\left(t\\right),\\ \\sin\\left(t\\right),\\ \\frac{t}{2}\\right]"
        },
        "description": "Curve Function"
      }
    },
    {
      "id": "7",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "T\\left(t\\right)",
          "rhs": "\\operatorname{unitT}\\left(r,\\ t\\right)"
        },
        "description": "Unit Tangent Vector"
      }
    },
    {
      "id": "8",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "R\\left(t\\right)",
          "rhs": "\\sqrt{\\frac{\\operatorname{diff}\\left(r,t\\right) \\cdot \\operatorname{diff}\\left(r,t\\right)}{\\operatorname{diff}\\left(T,t\\right) \\cdot \\operatorname{diff}\\left(T,t\\right)}}"
        },
        "description": "Radius of Curvature"
      }
    },
    {
      "id": "9",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "f\\left(u,\\ t\\right)",
          "rhs": "r\\left(u\\right)+R\\left(u\\right)\\cdot\\left(N\\left(u\\right)+\\cos\\left(t\\right)T\\left(u\\right)+\\sin\\left(t\\right)N\\left(u\\right)\\right)"
        },
        "description": "Osculating Circle Function\nThe circle is tangent to the curve at r(u); t parametrizes the circle."
      }
    },
    {
      "id": "10",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "N\\left(t\\right)",
          "rhs": "\\operatorname{unitN}\\left(r,\\ t\\right)"
        },
        "description": "Unit Normal Vector"
      }
    }

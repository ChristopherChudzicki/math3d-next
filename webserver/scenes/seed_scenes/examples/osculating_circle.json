    {
      "id": "2",
      "type": "VARIABLE_SLIDER",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "S",
          "rhs": "-0.12566370614358988"
        },
        "fps": "60",
        "range": {
          "type": "array",
          "items": ["-2\\pi", "2\\pi"]

    {
      "id": "2",
      "type": "PARAMETRIC_CURVE",
      "properties": {
        "description": "Parametric Curve\nOnce a function is defined, we can re-use it for different purposes. Here, we draw a curve.",
        "color": "#3090FF",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "size": "6",
        "width": "4",
        "start": "false",
        "end": "false",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["t"],
          "rhs": "f\\left(t\\right)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "expr",
              "expr": "\\left[-4,\\ 4\\right]"
            }
          ]
        },
        "samples1": "128"
      }
    },
    {
      "id": "3",
      "type": "POINT",
      "properties": {
        "description": "Point\nAnd here we animate a point. Note that \"T\" is the slider value.",
        "color": "#e74c3c",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "1",
        "zOrder": "",
        "label": "",
        "labelVisible": "false",
        "coords": "f\\left(T\\right)",
        "size": "16"
      }
    },
    {
      "id": "1",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "f\\left(t\\right)",
          "rhs": "\\left[t,\\ 3\\cdot\\cos\\left(\\pi\\ t\\right),\\ 2\\sin\\left(\\pi\\ t\\right)\\right]"
        },
        "description": "Function\nFunctions can be scalar-valued or vector-valued. Here's a vector-valued function."
      }
    },
    {
      "id": "4",
      "type": "VARIABLE_SLIDER",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "T",
          "rhs": "-2.900000000000004"
        },
        "fps": "60",
        "range": {
          "type": "array",
          "items": ["-4", "4"]
        },
        "duration": "4",
        "description": "Variable Slider",
        "isAnimating": "true",
        "speedMultiplier": "1"
      }

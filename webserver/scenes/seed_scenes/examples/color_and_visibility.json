    {
      "id": "1",
      "type": "EXPLICIT_SURFACE_POLAR",
      "properties": {
        "description": "Explicit Surface (Polar)\nPress the colored dot next to a graphics object to toggle visibility; press and hold to change color.",
        "color": "#e67e22",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "0.75",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["r", "\\theta"],
          "rhs": "\\frac{1}{4}r^2\\cdot\\cos\\left(3\\theta\\right)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["\\theta"],
              "rhs": "\\left[0,\\ 3\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["r"],
              "rhs": "\\left[-\\pi,\\ \\pi\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y", "z", "r", "\\theta"],
          "rhs": "mod(\\operatorname{rescale}_z\\left(z\\right), 1)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "64",
        "samples2": "64",
        "grid1": "8",
        "grid2": "8"
      }
    }

    {
      "id": "2",
      "type": "PARAMETRIC_CURVE",
      "properties": {
        "description": "Parametric Curve\nThis red curve lies on the blue surface, so it is hard to see: the renderer can't tell which one to draw on top.",
        "color": "#e74c3c",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "size": "6",
        "width": "6",
        "start": "false",
        "end": "false",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["t"],
          "rhs": "\\left[t,\\ 2,\\ f\\left(t,\\ 2\\right)\\right]"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "expr",
              "expr": "\\left[-2,2\\right]"
            }
          ]
        },
        "samples1": "128"
      }
    },
    {
      "id": "3",
      "type": "PARAMETRIC_CURVE",
      "properties": {
        "description": "Parametric Curve\nThis yellow curve also lies on the surface, but its Z-Bias of 1 draws it on top from every angle. To set Z-Bias, open its settings (press the gear).\nZ-Bias nudges an object toward the camera; here \"z\" means the direction toward the camera, not the z-axis.",
        "color": "#f1c40f",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "1",
        "zOrder": "",
        "size": "6",
        "width": "6",
        "start": "false",
        "end": "false",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["t"],
          "rhs": "\\left[t,\\ 2.1,\\ f\\left(t,2.1\\right)\\right]"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "expr",
              "expr": "\\left[-2,2\\right]"
            }
          ]
        },
        "samples1": "128"
      }
    },
    {
      "id": "5",
      "type": "EXPLICIT_SURFACE",
      "properties": {
        "description": "Explicit Surface",
        "color": "#3090FF",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y"],
          "rhs": "f\\left(x,\\ y\\right)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["y"],
              "rhs": "\\left[-2,2\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["x"],
              "rhs": "\\left[-3,3\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y", "z"],
          "rhs": "mod(\\operatorname{rescale}_z\\left(z\\right), 1)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "64",
        "samples2": "64",
        "grid1": "8",
        "grid2": "8"
      }
    },
    {
      "id": "4",
      "type": "VARIABLE",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "f\\left(x,\\ y\\right)",
          "rhs": "\\frac{1}{2}y^2-x^2"
        },
        "description": "Function"
      }
    }
  ],

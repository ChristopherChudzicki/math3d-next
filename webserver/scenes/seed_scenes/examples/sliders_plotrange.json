    {
      "id": "1",
      "type": "PARAMETRIC_CURVE",
      "properties": {
        "description": "Parametric Curve\nSliders can be used to animate the plot range for curves and surfaces.",
        "color": "#e67e22",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "1",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "size": "6",
        "width": "4",
        "start": "false",
        "end": "false",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["t"],
          "rhs": "\\left[4\\cos\\left(2t\\right),\\ 2\\sin\\left(2t\\right),\\ t\\right]"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "expr",
              "expr": "\\left[-2\\pi,\\ T\\right]"
            }
          ]
        },
        "samples1": "128"
      }
    },
    {
      "id": "3",
      "type": "VARIABLE_SLIDER",
      "properties": {
        "value": {
          "type": "assignment",
          "lhs": "T",
          "rhs": "-2.6179938779914855"
        },
        "fps": "60",
        "range": {
          "type": "array",
          "items": ["-2\\pi", "2\\pi"]
        },
        "duration": "4",
        "description": "Variable Slider\nSlider endpoints can contain symbols like pi, or other even variables.",
        "isAnimating": "true",
        "speedMultiplier": "1"
      }
    }

        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["u", "v"],
          "rhs": "\\left[(2+\\cos(v))\\cos(u), (2+\\cos(v))\\sin(u), \\sin(v)\\right]"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["v"],
              "rhs": "\\left[-\\pi, \\pi\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["u"],
              "rhs": "\\left[-\\pi, \\pi\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y", "z", "u", "v"],
          "rhs": "\\operatorname{mod}(\\operatorname{rescale}_z(z),1)"
        },

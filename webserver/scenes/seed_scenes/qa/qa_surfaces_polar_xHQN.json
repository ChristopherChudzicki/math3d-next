      "properties": {
        "description": "Explicit Surface (Polar)",
        "color": "#ff8800",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "0.5",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["r", "\\theta"],
          "rhs": "\\frac{1}{4} \\cdot r^2 \\cdot \\cos(3\\theta)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["\\theta"],
              "rhs": "[0, 2+\\cos(3\\theta)]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["r"],
              "rhs": "[-\\pi, \\pi]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["X", "Y", "Z", "r", "\\theta"],
          "rhs": "mod(Z, 1)"
        },
        "gridOpacity": "0.5",
        "gridWidth": "2",
        "samples1": "64",
        "samples2": "64",
        "grid1": "8",
        "grid2": "8"
      }

      "type": "EXPLICIT_SURFACE",
      "properties": {
        "description": "Explicit Surface",
        "color": "rainbow",
        "visible": true,
        "calculatedVisibility": "",
        "useCalculatedVisibility": false,
        "opacity": "0.6",
        "zIndex": "0",
        "zBias": "0",
        "zOrder": "",
        "shaded": "true",
        "expr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["x", "y"],
          "rhs": "\\sin(x)\\cos(y)"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["y"],
              "rhs": "[-3, 3]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["x"],
              "rhs": "[-3, 3]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["X", "Y", "Z", "x", "y"],
          "rhs": "mod(Z, 1)"
        },
        "gridOpacity": "1",
        "gridWidth": "4",
        "samples1": "64",
        "samples2": "64",
        "grid1": "6",
        "grid2": "6"
      }
    },
    {

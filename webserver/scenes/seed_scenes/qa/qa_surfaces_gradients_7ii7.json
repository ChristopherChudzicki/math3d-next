          "type": "function-assignment",
          "name": "_f",
          "params": ["u", "v"],
          "rhs": "\\left[u, v, (u^2-v^2)/6\\right]"
        },
        "domain": {
          "type": "array",
          "items": [
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["v"],
              "rhs": "\\left[-3, 3\\right]"
            },
            {
              "type": "function-assignment",
              "name": "_f",
              "params": ["u"],
              "rhs": "\\left[-3, 3\\right]"
            }
          ]
        },
        "colorExpr": {
          "type": "function-assignment",
          "name": "_f",
          "params": ["X", "Y", "Z", "u", "v"],
          "rhs": "(X+3)/6"

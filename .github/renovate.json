{
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "The router's CLI and Vite plugin must pin the same @tanstack/router-generator.",
      "matchPackageNames": [
        "@tanstack/react-router",
        "@tanstack/router-plugin",
        "@tanstack/router-cli"
      ],
      "groupName": "TanStack Router"
    }
  ]
}

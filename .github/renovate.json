{
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Use.GPU is alpha and renames between minors: one PR for all @use-gpu packages, opened only on approval from the dependency dashboard.",
      "matchPackageNames": ["@use-gpu/**"],
      "groupName": "use.gpu",
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}

{
  "name": "math3d-next",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.8.1",
  "devDependencies": {
    "@math3d/eslint-config": "workspace:*",
    "ts-node": "^10.9.2",
    "turbo": "^2.10.13",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test-e2e": "yarn workspace app-tests-e2e test-e2e",
    "typecheck": "turbo run typecheck",
    "start": "yarn workspace app start",
    "build": "yarn workspace app build",
    "preview": "yarn workspace app preview",
    "fmt-check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check ."
  },
  "dependencies": {
    "package": "^1.0.1",
    "prettier": "4.0.0-alpha.8"
  },
  "resolutions": {
    "undici@npm:7.29.0": "7.30.1",
    "undici@npm:7.29.1": "7.30.1",
    "sharp@npm:0.35.2": "0.35.5",
    "sharp@npm:0.35.4": "0.35.5"
  },
  "msw": {
    "workerDirectory": "packages/app/public"
  }
}
